# Career Transition OS - server-side environment configuration
# Copy this file to .env.local and fill in real values. Never commit .env.local.

# OpenAI-compatible LLM provider. Works with OpenAI, Azure OpenAI (compatible mode),
# OpenRouter, local vLLM/Ollama-with-OpenAI-shim, or any other OpenAI-compatible endpoint.
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_API_KEY=sk-placeholder-do-not-commit-a-real-key
AI_PROVIDER_MODEL=gpt-4o-mini

# Optional owner-passphrase gate for /api/ai/*. Leave unset for local-only use.
# Set this to a long random string before deploying anywhere reachable by others -
# Settings will then ask for this passphrase once per browser (stored as an httpOnly
# cookie) before the assistant or connection test can be used, so an unauthenticated
# caller can't hit your deployed AI endpoint and spend your API budget.
AI_ENDPOINT_ACCESS_TOKEN=change-me-to-a-long-random-string

# Optional: cap tool-call loop length and per-request timeout.
AI_MAX_TOOL_ITERATIONS=6
AI_REQUEST_TIMEOUT_MS=30000
